<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="test_access_profile_view_list" model="ir.ui.view">
        <field name="name">test.access.profile.list</field>
        <field name="model">test.access.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="test_access_profile_view_form" model="ir.ui.view">
        <field name="name">test.access.profile.form</field>
        <field name="model">test.access.profile</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Export XLSX" type="object" name="action_export_xlsx" invisible="not id"/>
                    <button string="Upload XLSX" type="object" name="action_open_upload" invisible="not id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Accountant"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Access Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="model_id"/>
                                    <field name="group_id"/>
                                    <field name="for_create"/>
                                    <field name="for_read"/>
                                    <field name="for_write"/>
                                    <field name="for_unlink"/>
                                    <field name="domain"/>
                                    <field name="kind"/>
                                </list>
                            </field>
                        </page>
                        <page string="Users" name="users">
                            <field name="user_ids" widget="test_profile_users">
                                <list>
                                    <field name="name"/>
                                    <field name="login"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="test_access_profile_view_search" model="ir.ui.view">
        <field name="name">test.access.profile.search</field>
        <field name="model">test.access.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_ids"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="test_access_profile_action" model="ir.actions.act_window">
        <field name="name">Access Profiles</field>
        <field name="res_model">test.access.profile</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
