<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_dispatch_report_list" model="ir.ui.view">
        <field name="name">stock.dispatch.report.list</field>
        <field name="model">stock.dispatch.report</field>
        <field name="arch" type="xml">
            <list string="Dispatch Report" create="false" edit="false" delete="false">
                <field name="reference"/>
                <field name="product_id"/>
                <field name="default_code" optional="show"/>
                <field name="hsn_code" optional="hide"/>
                <field name="categ_id" optional="hide"/>
                <field name="product_uom_qty" sum="Demand"/>
                <field name="qty_done" sum="Done"/>
                <field name="quantity" sum="Quantity" optional="hide"/>
                <field name="uom_id" groups="uom.group_uom"/>
                <field name="picking_code"/>
                <field name="picking_type_id" optional="hide"/>
                <field name="partner_id" optional="show"/>
                <field name="scheduled_date"/>
                <field name="date_deadline" optional="hide"/>
                <field name="date_done" optional="hide"/>
                <field name="location_id" optional="hide"/>
                <field name="location_dest_id" optional="hide"/>
                <field name="origin" optional="hide"/>
                <field name="order_id" optional="hide"/>
                <field name="fiscal_position_id" optional="hide"/>
                <field name="picking_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="picked" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'assigned'"
                       decoration-warning="state in ('confirmed', 'waiting', 'partially_available')"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_stock_dispatch_report_pivot" model="ir.ui.view">
        <field name="name">stock.dispatch.report.pivot</field>
        <field name="model">stock.dispatch.report</field>
        <field name="arch" type="xml">
            <pivot string="Dispatch Report" sample="1">
                <field name="product_id" type="row"/>
                <field name="picking_code" type="col"/>
                <field name="product_uom_qty" type="measure"/>
                <field name="qty_done" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_stock_dispatch_report_graph" model="ir.ui.view">
        <field name="name">stock.dispatch.report.graph</field>
        <field name="model">stock.dispatch.report</field>
        <field name="arch" type="xml">
            <graph string="Dispatch Report" type="bar" sample="1">
                <field name="product_id"/>
                <field name="qty_done" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_stock_dispatch_report_search" model="ir.ui.view">
        <field name="name">stock.dispatch.report.search</field>
        <field name="model">stock.dispatch.report</field>
        <field name="arch" type="xml">
            <search string="Dispatch Report">
                <field name="product_id"/>
                <field name="default_code"/>
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="picking_id"/>
                <field name="origin"/>
                <field name="order_id"/>

                <filter name="filter_not_cancelled" string="Not Cancelled"
                        domain="[('state', '!=', 'cancel')]"/>
                <filter name="filter_done" string="Done"
                        domain="[('state', '=', 'done')]"/>
                <filter name="filter_pending" string="Pending"
                        domain="[('state', 'not in', ('done', 'cancel'))]"/>
                <separator/>
                <filter name="filter_incoming" string="Receipts"
                        domain="[('picking_code', '=', 'incoming')]"/>
                <filter name="filter_outgoing" string="Deliveries"
                        domain="[('picking_code', '=', 'outgoing')]"/>
                <filter name="filter_internal" string="Internal Transfers"
                        domain="[('picking_code', '=', 'internal')]"/>
                <filter name="filter_manufacturing" string="Manufacturing"
                        domain="[('picking_code', '=', 'mrp_operation')]"/>
                <filter name="filter_no_picking" string="Inventory Adjustments"
                        help="Moves not attached to any transfer"
                        domain="[('picking_id', '=', False)]"/>
                <separator/>
                <filter name="filter_late" string="Late"
                        help="Deadline or scheduled date already passed"
                        domain="[('state', 'not in', ('done', 'cancel')), '|',
                                 ('date_deadline', '&lt;', current_date),
                                 ('scheduled_date', '&lt;', current_date)]"/>
                <filter name="filter_from_sale" string="From Sale Order"
                        domain="[('sale_line_id', '!=', False)]"/>
                <separator/>
                <filter name="filter_scheduled" string="Scheduled Date"
                        date="scheduled_date"/>

                <group>
                    <filter name="group_product" string="Product"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_categ" string="Product Category"
                            context="{'group_by': 'categ_id'}"/>
                    <filter name="group_partner" string="Partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_picking_code" string="Type of Operation"
                            context="{'group_by': 'picking_code'}"/>
                    <filter name="group_picking_type" string="Operation Type"
                            context="{'group_by': 'picking_type_id'}"/>
                    <filter name="group_picking" string="Transfer"
                            context="{'group_by': 'picking_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_location_dest" string="Destination"
                            context="{'group_by': 'location_dest_id'}"/>
                    <filter name="group_company" string="Company"
                            groups="base.group_multi_company"
                            context="{'group_by': 'company_id'}"/>
                    <filter name="group_scheduled_date" string="Scheduled Date"
                            context="{'group_by': 'scheduled_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_dispatch_report" model="ir.actions.act_window">
        <field name="name">Dispatch Report</field>
        <field name="res_model">stock.dispatch.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_stock_dispatch_report_search"/>
        <field name="context">{'search_default_filter_not_cancelled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stock moves found
            </p>
            <p>
                This report lists every stock move with its demanded and
                done quantities, across receipts, deliveries and internal
                transfers.
            </p>
        </field>
    </record>

    <menuitem id="menu_stock_dispatch_report"
              name="Dispatch Report"
              parent="stock.menu_warehouse_report"
              action="action_stock_dispatch_report"
              sequence="50"/>

</odoo>
