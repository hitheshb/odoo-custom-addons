<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_patient_form" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <sheet>
                    <group>
                        <field name="patient_ref"/>
                        <field name="name"/>
                        <field name="date_of_birth"/>
                        <field name="age" readonly="1"/>
                        <field name="blood_group"/>
                        <field name="phone"/>
                        <field name="email"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_patient_list" model="ir.ui.view">
        <field name="name">hospital.patient.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="patient_ref"/>
                <field name="name"/>
                <field name="age"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="blood_group"/>
            </list>
        </field>
    </record>

    <record id="action_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_patient', '=', True)]</field>
        <field name="context">{'default_is_patient': True}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_hospital_patient_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hospital_patient_form')}),
        ]"/>
    </record>

    <menuitem id="menu_hospital_root" name="Hospital"/>

    <menuitem id="menu_hospital_patient"
              name="Patients"
              parent="menu_hospital_root"
              action="action_hospital_patient"
              sequence="10"/>




</odoo>
