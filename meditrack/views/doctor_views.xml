<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hospital.doctor.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Doctor">
                <sheet>
                    <group>
                        <field name="doctor_ref"/>
                        <field name="name"/>
                        <field name="specialization"/>
                        <field name="license_number"/>
                        <field name="years_of_experience"/>
                        <field name="phone"/>
                        <field name="email"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_doctor_list" model="ir.ui.view">
        <field name="name">hospital.doctor.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Doctors">
                <field name="doctor_ref"/>
                <field name="name"/>
                <field name="specialization"/>
                <field name="license_number"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="action_hospital_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_doctor', '=', True)]</field>
        <field name="context">{'default_is_doctor': True}</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_hospital_doctor_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_hospital_doctor_form')}),
        ]"/>
    </record>

    <menuitem id="menu_hospital_doctor"
              name="Doctors"
              parent="menu_hospital_root"
              action="action_hospital_doctor"
              sequence="20"/>

</odoo>
