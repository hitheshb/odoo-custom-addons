<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_dispatch_report_list" model="ir.ui.view">
        <field name="name">hospital.dispatch.report.list</field>
        <field name="model">hospital.dispatch.report</field>
        <field name="arch" type="xml">
            <list string="Dispatch Report" create="false" edit="false" delete="false">
                <field name="appointment_date"/>
                <field name="patient_id"/>
                <field name="patient_ref"/>
                <field name="doctor_id"/>
                <field name="medicine_name"/>
                <field name="dosage"/>
                <field name="duration"/>
                <field name="status"/>
                <field name="appointment_id" optional="hide"/>
                <field name="reason" optional="hide"/>
                <field name="temperature" optional="hide"/> 
                <field name="advice" optional="hide"/>
                <field name="blood_group" optional="hide"/>
                <field name="age" optional="hide"/>
                <field name="doctor_ref" optional="hide"/>
                <field name="specialization" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_hospital_dispatch_report" model="ir.actions.act_window">
        <field name="name">Dispatch Report</field>
        <field name="res_model">hospital.dispatch.report</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_hospital_dispatch_report"
              name="Dispatch Report"
              parent="menu_hospital_root"
              action="action_hospital_dispatch_report"
              sequence="50"/>

</odoo>
