<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hospital_appointment_form" model="ir.ui.view">
        <field name="name">hospital.appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,confirmed" options="{'clickable': true}"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="patient_id"/>
                        <field name="doctor_id"/>
                        <field name="appointment_date"/>
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hospital_appointment_list" model="ir.ui.view">
        <field name="name">hospital.appointment.list</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <list string="Appointments"
                  decoration-info="status == 'draft'"
                  decoration-success="status == 'confirmed'"
                  decoration-muted="status == 'done'"
                  decoration-danger="status == 'cancelled'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_date"/>
                <field name="reason"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'draft'"
                       decoration-success="status == 'confirmed'"
                       decoration-muted="status == 'done'"
                       decoration-danger="status == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_appointment_calendar" model="ir.ui.view">
        <field name="name">hospital.appointment.calendar</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments" date_start="appointment_date" color="doctor_id">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <record id="action_hospital_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form,calendar</field>
    </record>

    <menuitem id="menu_hospital_appointment"
              name="Appointments"
              parent="menu_hospital_root"
              action="action_hospital_appointment"
              sequence="30"/>

</odoo>
