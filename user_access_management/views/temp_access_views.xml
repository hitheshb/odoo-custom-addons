<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="temp_access_view_list" model="ir.ui.view">
        <field name="name">user.temp.access.list</field>
        <field name="model">user.temp.access</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('expired', 'cancelled')">
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="group_ids" widget="many2many_tags" options="{'color_field': 'uam_color'}"/>
                <field name="date_from"/>
                <field name="date_to" widget="relative_date"/>
                <field name="state" widget="badge" decoration-info="state == 'scheduled'" decoration-success="state == 'active'" decoration-danger="state == 'expired'" decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>
    <record id="temp_access_view_form" model="ir.ui.view">
        <field name="name">user.temp.access.form</field>
        <field name="model">user.temp.access</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state not in ('scheduled', 'active')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Active" bg_color="text-bg-success" invisible="state != 'active'"/>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger" invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>
                    <group>
                        <group>
                            <field name="user_id" readonly="state != 'scheduled'"/>
                            <field name="group_ids" widget="many2many_tags" options="{'color_field': 'uam_color'}" readonly="state != 'scheduled'"/>
                        </group>
                        <group>
                            <field name="date_from" readonly="state != 'scheduled'"/>
                            <field name="date_to" readonly="state in ('expired', 'cancelled')"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="temp_access_view_search" model="ir.ui.view">
        <field name="name">user.temp.access.search</field>
        <field name="model">user.temp.access</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="group_ids"/>
                <filter name="scheduled" string="Scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="temp_access_view_calendar" model="ir.ui.view">
        <field name="name">user.temp.access.calendar</field>
        <field name="model">user.temp.access</field>
        <field name="arch" type="xml">
            <calendar date_start="date_from" date_stop="date_to" color="user_id" mode="month" quick_create="0">
                <field name="user_id"/>
                <field name="group_ids" widget="many2many_tags" options="{'color_field': 'uam_color'}"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>
    <record id="temp_access_action" model="ir.actions.act_window">
        <field name="name">Temporary Access</field>
        <field name="res_model">user.temp.access</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="temp_access_view_search"/>
    </record>
</odoo>
