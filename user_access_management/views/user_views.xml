<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="user_list_view" model="ir.ui.view">
        <field name="name">user.access.user.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list create="false" delete="false" decoration-muted="not active">
                <header>
                    <button name="action_uam_archive_stale" type="object" groups="base.group_system" string="Archive stale users"
                            confirm="Archive the selected users who haven't logged in recently? Administrators and yourself are skipped."/>
                    <button name="action_uam_remind_stale" type="object" groups="base.group_system" string="Send login reminder"
                            confirm="Email a login reminder to the selected users who haven't logged in recently?"/>
                </header>
                <field name="avatar_128" widget="image" options="{'size': [24, 24], 'img_class': 'o_avatar rounded-circle'}" string=" " width="30"/>
                <field name="name"/>
                <field name="im_status" string=" " widget="uam_status_dot"/>
                <field name="login"/>
                <field name="group_ids" widget="many2many_tags" options="{'color_field': 'uam_color'}" optional="hide"/>
                <field name="uam_group_count" string="Groups" width="90px"/>
                <field name="uam_access_count" string="Rights" width="90px"/>
                <field name="active" column_invisible="1"/>
                <field name="uam_login_stale" column_invisible="1"/>
                <field name="login_date" widget="relative_date" decoration-danger="uam_login_stale"/>
                <field name="uam_last_work" string="Last Work Update" optional="show"/>
            </list>
        </field>
    </record>

    <record id="user_kanban_view" model="ir.ui.view">
        <field name="name">user.access.user.kanban</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <kanban create="false" delete="false" class="o_kanban_mobile">
                <header>
                    <button name="action_uam_archive_stale" type="object" groups="base.group_system" string="Archive stale users"
                            confirm="Archive the selected users who haven't logged in recently? Administrators and yourself are skipped."/>
                    <button name="action_uam_remind_stale" type="object" groups="base.group_system" string="Send login reminder"
                            confirm="Email a login reminder to the selected users who haven't logged in recently?"/>
                </header>
                <field name="active"/>
                <field name="uam_login_stale"/>
                <field name="im_status"/>
                <field name="uam_current_page"/>
                <field name="uam_lock_count"/>
                <field name="uam_temp_count"/>
                <field name="uam_last_work"/>
                <templates>
                    <t t-name="card" class="flex-row align-items-center gap-3">
                        <aside t-attf-class="o_uam_ring o_uam_ring--#{record.im_status.raw_value} #{record.active.raw_value ? '' : 'opacity-50'}" style="width: 64px; height: 64px;">
                            <field name="avatar_128" widget="image" alt="Avatar" options="{'img_class': 'rounded-circle w-100 h-100 object-fit-cover'}"/>
                        </aside>
                        <main t-attf-class="flex-grow-1 min-w-0 #{record.active.raw_value ? '' : 'opacity-50'}">
                            <field class="fw-bold fs-5 text-truncate d-block" name="name"/>
                            <div class="text-truncate small" style="color: var(--uam-accent)" t-if="record.uam_current_page.raw_value"><field name="uam_current_page"/></div>
                            <div class="text-muted text-truncate small"><span class="oi me-1" data-icon="mail" title="Email"/><field name="login"/></div>
                            <div class="d-flex flex-wrap gap-1 mt-2">
                                <span class="o_uam_badge o_uam_badge--accent"><field name="uam_group_count"/> groups</span>
                                <span class="o_uam_badge"><field name="uam_access_count"/> rights</span>
                                <span t-if="record.uam_lock_count.raw_value" class="o_uam_badge o_uam_badge--alert"><field name="uam_lock_count"/> locks</span>
                                <span t-if="record.uam_temp_count.raw_value" class="o_uam_badge o_uam_badge--away"><field name="uam_temp_count"/> temporary</span>
                                <span t-if="record.uam_login_stale.raw_value" class="o_uam_badge o_uam_badge--alert">Stale login</span>
                            </div>
                            <div class="text-muted small mt-1 text-truncate" t-if="record.uam_last_work.raw_value">
                                <span class="oi me-1" data-icon="edit" title="Last work update"/><field name="uam_last_work"/>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="user_search_view" model="ir.ui.view">
        <field name="name">user.access.user.search</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('login', 'ilike', self)]" string="User"/>
                <field name="group_ids"/>
                <filter name="internal" string="Internal" domain="[('share', '=', False)]"/>
                <filter name="portal" string="Portal / Public" domain="[('share', '=', True)]"/>
                <separator/>
                <filter name="stale" string="Stale Login" domain="[('uam_login_stale', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="active_only" string="Active Only" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="user_form_view" model="ir.ui.view">
        <field name="name">user.access.user.form</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <widget name="web_ribbon" title="Stale login" bg_color="text-bg-danger" invisible="not uam_login_stale"/>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_uam_open_groups">
                            <field name="uam_group_count" widget="statinfo" string="Groups"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_uam_open_access">
                            <field name="uam_access_count" widget="statinfo" string="Access Rights"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_uam_open_locks">
                            <field name="uam_lock_count" widget="statinfo" string="Locks"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_uam_open_temp">
                            <field name="uam_temp_count" widget="statinfo" string="Temporary Access"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_uam_open_prints">
                            <field name="uam_print_count" widget="statinfo" string="Prints"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_uam_open_usage">
                            <field name="uam_usage_count" widget="statinfo" string="Screens Opened"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_uam_open_changes">
                            <field name="uam_change_count" widget="statinfo" string="Changes"/>
                        </button>
                    </div>
                    <field name="avatar_128" widget="image" class="oe_avatar"/>
                    <field name="uam_login_stale" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" placeholder="Name"/></h1>
                        <h3 class="text-muted"><span class="oi me-2" data-icon="mail" title="Email"/><field name="login" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="im_status" widget="uam_status_dot" string="Status"/>
                            <field name="login_date" readonly="1" decoration-danger="uam_login_stale"/>
                            <field name="uam_current_page"/>
                            <field name="uam_last_seen" widget="relative_date"/>
                        </group>
                        <group>
                            <field name="uam_last_work" string="Last Work Update"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Timeline" name="timeline">
                            <field name="uam_timeline_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Groups" name="groups">
                            <field name="group_ids" context="{'form_view_ref': 'user_access_management.group_form_view', 'list_view_ref': 'user_access_management.group_list_view'}"/>
                        </page>
                        <page string="Effective Groups" name="effective_groups">
                            <field name="all_group_ids" readonly="1" context="{'form_view_ref': 'user_access_management.group_form_view', 'list_view_ref': 'user_access_management.group_list_view'}"/>
                        </page>
                        <page string="Effective Access Rights" name="effective_access">
                            <field name="uam_access_ids" readonly="1" context="{'form_view_ref': 'user_access_management.access_form_view', 'list_view_ref': 'user_access_management.access_list_view'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="user_action" model="ir.actions.act_window">
        <field name="name">Users</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'active_test': False, 'search_default_active_only': 1}</field>
        <field name="search_view_id" ref="user_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No users match</p>
            <p>Clear the filters to see everyone.</p>
        </field>
    </record>
    <record id="user_action_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="0"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="user_kanban_view"/>
        <field name="act_window_id" ref="user_action"/>
    </record>
    <record id="user_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="user_list_view"/>
        <field name="act_window_id" ref="user_action"/>
    </record>
    <record id="user_action_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="user_form_view"/>
        <field name="act_window_id" ref="user_action"/>
    </record>
</odoo>
