<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="access_change_log_list_view" model="ir.ui.view">
        <field name="name">access.change.log.list</field>
        <field name="model">access.change.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="acting_user_id"/>
                <field name="action"/>
                <field name="target_kind"/>
                <field name="target_name"/>
                <field name="field_label"/>
                <field name="old_value"/>
                <field name="new_value"/>
            </list>
        </field>
    </record>

    <record id="access_change_log_search_view" model="ir.ui.view">
        <field name="name">access.change.log.search</field>
        <field name="model">access.change.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="target_name"/>
                <field name="acting_user_id"/>
                <field name="old_value"/>
                <field name="new_value"/>
                <filter name="today" string="Today" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                    <filter name="group_kind" string="Target Kind" context="{'group_by': 'target_kind'}"/>
                    <filter name="group_user" string="Changed By" context="{'group_by': 'acting_user_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="access_change_log_action" model="ir.actions.act_window">
        <field name="name">Change Log</field>
        <field name="res_model">access.change.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
