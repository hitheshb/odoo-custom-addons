<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_grocery_management" model="ir.module.category">
        <field name="name">Grocery Management</field>
        <field name="sequence">20</field>
    </record>

    <record id="grocery_groups_privilege" model="res.groups.privilege">
        <field name="name">Grocery Management</field>
        <field name="category_id" ref="module_category_grocery_management"/>
    </record>

    <record id="group_grocery_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="grocery_groups_privilege"/>
        <field name="sequence">10</field>
        <field name="comment">Can manage products, customers and sales, but only sees the sales they created.</field>
    </record>

    <record id="group_grocery_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="grocery_groups_privilege"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_grocery_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Everything a User can do, plus visibility into every sale and the Grocery Management settings.</field>
    </record>

</odoo>
