<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_grocery_customer_list" model="ir.ui.view">
        <field name="name">grocery.customer.list</field>
        <field name="model">grocery.customer</field>

        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>


    <record id="view_grocery_customer_search" model="ir.ui.view">
        <field name="name">grocery.customer.search</field>
        <field name="model">grocery.customer</field>

        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="customer_id"/>
            </search>
        </field>
    </record>


    <record id="view_grocery_customer_form" model="ir.ui.view">
        <field name="name">grocery.customer.form</field>
        <field name="model">grocery.customer</field>

        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sales" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="sale_count" widget="statinfo" string="Sales"/>
                        </button>
                    </div>

                    <group>
                        <field name="name"/>
                        <field name="customer_id"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="address"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>