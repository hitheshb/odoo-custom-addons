<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <menuitem
        id="menu_grocery_management"
        name="Grocery Management"
    />

    <record id="action_grocery_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">grocery.product</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_grocery_product"
        name="Products"
        parent="menu_grocery_management"
        action="action_grocery_product"
        sequence="10"
    />

    <record id="action_grocery_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">grocery.customer</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_grocery_customer"
        name="Customers"
        parent="menu_grocery_management"
        action="action_grocery_customer"
        sequence="20"
    />
    <record id="action_grocery_sale" model="ir.actions.act_window">
        <field name="name">Sales</field>
        <field name="res_model">grocery.sale</field>
        <field name="view_mode">list,form,calendar</field>
    </record>

    <menuitem
        id="menu_grocery_sale"
        name="Sales"
        parent="menu_grocery_management"
        action="action_grocery_sale"
        sequence="30"
    />

</odoo>