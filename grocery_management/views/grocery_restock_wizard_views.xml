<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_grocery_restock_wizard_form" model="ir.ui.view">
        <field name="name">grocery.restock.wizard.form</field>
        <field name="model">grocery.restock.wizard</field>
        <field name="arch" type="xml">
            <form string="Restock Product">
                <group>
                    <field name="product_id" readonly="1"/>
                    <field name="current_quantity"/>
                    <field name="quantity_to_add"/>
                </group>
                <footer>
                    <button string="Confirm" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_grocery_restock_wizard" model="ir.actions.act_window">
        <field name="name">Restock Product</field>
        <field name="res_model">grocery.restock.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
